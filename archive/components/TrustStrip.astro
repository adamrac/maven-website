---
/**
 * Flat band of things that are actually true about Marlo. Sits where a shipped
 * product would put integration logos or an App Store rating — Marlo is
 * pre-launch and has neither.
 */
const facts = [
  'Australian owned & built',
  'Data stored in Sydney',
  'Non-diagnostic by design',
  'Clinically reviewed content',
  'Export or delete any time',
];
---

<section class="strip" aria-label="What is true about Marlo">
  <ul class="page strip-list">
    {facts.map((f) => <li class="strip-item">{f}</li>)}
  </ul>
</section>

<style>
  .strip {
    background: var(--cream-deep);
    border-bottom: 1px solid var(--line);
    padding-block: 1.25rem;
  }

  .strip-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem clamp(1.25rem, 0.5rem + 2.5vw, 3rem);
  }

  .strip-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .strip-item::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--clay);
    flex-shrink: 0;
  }
</style>
