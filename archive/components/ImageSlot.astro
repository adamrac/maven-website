---
/**
 * An art-directed slot where brand photography goes.
 *
 * The brand guidelines specify the shoot — "real women, real light, real life"
 * — but carry no photographs; page 21 of the deck is itself three dashed
 * placeholders with captions. This reproduces that treatment deliberately,
 * rather than filling the gap with off-brand stock.
 *
 * To use a real image, pass `src`. The caption then becomes the alt text.
 */
interface Props {
  /** Art direction for this slot — what should be shot here. */
  brief: string;
  src?: string;
  alt?: string;
  /** Aspect ratio, e.g. "4 / 5" or "16 / 10". */
  ratio?: string;
  class?: string;
}

const { brief, src, alt, ratio = '4 / 5', class: className = '' } = Astro.props;
---

{
  src ? (
    <img class:list={['slot-img', className]} src={src} alt={alt ?? brief} style={`aspect-ratio:${ratio}`} />
  ) : (
    <figure class:list={['slot', className]} style={`aspect-ratio:${ratio}`}>
      <svg class="slot-icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="4" width="18" height="16" rx="3" />
        <circle cx="9" cy="10" r="1.6" />
        <path d="M4 17.5 9.5 12l4 4 2.5-2.2 4 3.7" />
      </svg>
      <figcaption class="slot-brief">{brief}</figcaption>
    </figure>
  )
}

<style>
  .slot {
    margin: 0;
    width: 100%;
    border-radius: var(--r-lg);
    border: 1.5px dashed var(--line);
    background: var(--cream-deep);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 1.5rem;
    text-align: center;
  }

  .slot-icon {
    width: 1.6rem;
    height: 1.6rem;
    stroke: var(--ink-faint);
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .slot-brief {
    font-size: var(--t-caption);
    color: var(--ink-faint);
    max-width: 22ch;
    line-height: 1.45;
  }

  .slot-img {
    width: 100%;
    object-fit: cover;
    border-radius: var(--r-lg);
  }

  /* On a dark surface the placeholder inverts so it stays legible. */
  :global(.on-berry) .slot {
    background: rgba(251, 244, 226, 0.06);
    border-color: var(--line-inverse);
  }

  :global(.on-berry) .slot-icon {
    stroke: rgba(251, 244, 226, 0.5);
  }

  :global(.on-berry) .slot-brief {
    color: rgba(251, 244, 226, 0.6);
  }
</style>
