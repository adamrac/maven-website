---
import Base from '../layouts/Base.astro';
import HeroStory from '../components/HeroStory.astro';
import StoryCard from '../components/StoryCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Icon from '../components/Icon.astro';
import Marquee from '../components/Marquee.astro';
import PhoneDemo from '../components/PhoneDemo.astro';
import HealthReport from '../components/HealthReport.astro';
import { APP_STORE_URL, PLAY_STORE_URL, DOWNLOAD_ANCHOR } from '../site';

/*
 * One page, told as a story, in plain words:
 *   hero → is this you? → it shouldn't be this hard → how Marlo helps →
 *   like a friend would → the sentence → show your doctor → what's inside →
 *   you're safe here → download.
 * Every call to action on the page is the same one: download the app.
 */

const truths = [
  'You’ve been told everything looks normal, but you don’t feel normal.',
  'You’ve been told it’s “probably just stress.”',
  'You see different doctors, and none of them talk to each other.',
  'You’re the one keeping track of everything.',
  'You’re tired of starting from scratch at every appointment.',
];

const how = [
  {
    title: 'Check in',
    body: 'Tap how you’re feeling. It takes seconds, and missing a day is fine.',
  },
  {
    title: 'Notice patterns',
    body: 'Marlo spots things you might miss, like feeling low at the same time each month.',
  },
  {
    title: 'Feel ready',
    body: 'Get a reminder before each appointment, with your notes ready to show.',
  },
];

const inside1 = [
  { icon: 'drop' as const, label: 'Periods & cycle' },
  { icon: 'sun' as const, label: 'Mood' },
  { icon: 'moon' as const, label: 'Sleep' },
  { icon: 'sprout' as const, label: 'Symptoms' },
  { icon: 'chart' as const, label: 'Patterns' },
  { icon: 'note' as const, label: 'Health summary' },
];
const inside2 = [
  { icon: 'bell' as const, label: 'Check-up reminders' },
  { icon: 'calendar' as const, label: 'Appointments & notes' },
  { icon: 'book' as const, label: 'Trusted articles' },
  { icon: 'people' as const, label: 'A caring community' },
  { icon: 'lock' as const, label: 'Your documents' },
  { icon: 'share' as const, label: 'Share when you choose' },
];

const promise = [
  {
    tone: 'clay' as const,
    blob: 'cream' as const,
    icon: 'heart' as const,
    title: 'No judgement.',
    body: 'Share as much or as little as you like, at your own pace.',
  },
  {
    tone: 'sky' as const,
    blob: 'blush' as const,
    icon: 'people' as const,
    title: 'Everyone’s welcome.',
    body: 'Whatever your age, body or background, Marlo is for you.',
  },
  {
    tone: 'butter' as const,
    blob: 'blush' as const,
    icon: 'shield' as const,
    title: 'You’re in control.',
    body: 'Skip, pause or delete anything, whenever you like.',
  },
  {
    tone: 'berry' as const,
    blob: 'clay' as const,
    icon: 'lock' as const,
    title: 'Private, always.',
    body: 'Protected, never sold, and yours to delete any time.',
  },
];

const safety = [
  { icon: 'shield' as const, title: 'We don’t diagnose', body: 'Marlo helps you see what’s going on. Your doctor makes the diagnosis.' },
  { icon: 'heart' as const, title: 'Help when you need it', body: 'If something you write sounds urgent, we’ll show you who to call.' },
  { icon: 'share' as const, title: 'Quick exit', body: 'One tap closes Marlo and opens a plain page, if you need privacy.' },
  { icon: 'lock' as const, title: 'Delete anything', body: 'Your notes and files are yours. Remove them whenever you like.' },
];

const stores = [
  { name: 'App Store', pre: 'Download on the', href: APP_STORE_URL, icon: 'apple' },
  { name: 'Google Play', pre: 'Get it on', href: PLAY_STORE_URL, icon: 'play' },
];

/* Little pieces of the app inside the feature cards */
const energy = [5, 6, 4, 6, 7, 6, 5, 6, 4, 3, 2, 3, 2, 3];
const sleepBars = [7, 6, 7, 8, 7, 6, 7, 7, 6, 5, 5, 4, 5, 5];
const lists = [
  { icon: 'calendar' as const, t: 'GP appointment', m: 'Thu, 9:15am' },
  { icon: 'note' as const, t: 'Blood test results', m: 'Added today' },
  { icon: 'bell' as const, t: 'Cervical screening', m: 'Due in 3 weeks' },
];
---

<Base
  title="Marlo"
  description="Marlo helps women keep track of their health, understand what their body is telling them, and feel ready for every doctor’s appointment."
>
  <HeroStory />

  <!-- ═══════════════════════════════════════════════════ is this you? -->
  <section class="section" id="story">
    <div class="page story">
      <header class="head">
        <h2 class="h1" data-split>You’re not imagining it.</h2>
        <p class="head-sub reveal">If any of this sounds familiar, you’re in the right place.</p>
      </header>

      <ol class="truths" data-spotlight>
        {
          truths.map((t, i) => (
            <li class="truth">
              <span class="numeral truth-num">{String(i + 1).padStart(2, '0')}</span>
              <p class="truth-text">{t}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ it shouldn't be this hard -->
  <section class="panel on-berry turn-sec">
    <div class="page">
      <p class="display turn" data-scrub>
        It shouldn’t be this hard. <span class="turn-b">So we made it easier.</span>
      </p>
    </div>
  </section>

  <!-- ═════════════════════════════════════════════════ how marlo helps -->
  <section class="section" id="meet">
    <div class="page">
      <header class="head">
        <h2 class="h1" data-split>Here’s how Marlo helps.</h2>
        <p class="head-sub reveal">
          One simple app that keeps your health in one place, and helps you make sense of it.
        </p>
      </header>

      <div class="jobs">
        <div class="reveal">
          <FeatureCard
            tone="sky"
            title="See the bigger picture"
            body="Log your cycle, mood, sleep and symptoms, and see how they connect."
          >
            <div class="mock mock-chart">
              <p class="mock-k">This month</p>
              <div class="mock-rows">
                {
                  [
                    { label: 'Energy', bars: energy },
                    { label: 'Sleep', bars: sleepBars },
                  ].map((row) => (
                    <div class="mock-row">
                      <span class="mock-label">{row.label}</span>
                      <span class="mock-bars">
                        {row.bars.map((h, i) => (
                          <i class:list={[i >= 9 && 'is-hi']} style={`--h:${h / 8};--i:${i}`} />
                        ))}
                      </span>
                    </div>
                  ))
                }
              </div>
              <p class="mock-note">
                <span class="mock-dot"></span>Lower in the week before your period
              </p>
            </div>
          </FeatureCard>
        </div>

        <div class="reveal" style="--delay:110ms">
          <FeatureCard
            tone="blush"
            title="Keep it all in one place"
            body="Appointments, notes, results and reminders, all together in one place."
          >
            <ul class="mock mock-list">
              {
                lists.map((l, i) => (
                  <li style={`--i:${i}`}>
                    <span class="mock-ic">
                      <Icon name={l.icon} />
                    </span>
                    <span class="mock-t">{l.t}</span>
                    <span class="mock-m">{l.m}</span>
                  </li>
                ))
              }
            </ul>
          </FeatureCard>
        </div>

        <div class="reveal" style="--delay:220ms">
          <FeatureCard
            tone="butter"
            title="Be heard by your doctor"
            body="Turn months of check-ins into one simple page to show your GP."
          >
            <div class="mock mock-doc">
              <p class="mock-k">Your health summary</p>
              <div class="mock-stats">
                <span><b class="numeral">142</b> check-ins</span>
                <span><b class="numeral">26–34</b> day cycles</span>
              </div>
              <span class="mock-line" style="--w:92%"></span>
              <span class="mock-line" style="--w:78%"></span>
              <span class="mock-line" style="--w:64%"></span>
              <span class="mock-share">
                <Icon name="share" /> Share with your GP
              </span>
            </div>
          </FeatureCard>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════════════════ like a friend would -->
  <section class="panel on-deep how-sec" id="how">
    <div class="page how">
      <div class="how-copy">
        <header class="head head-left">
          <h2 class="h1" data-split>It talks to you like a friend would.</h2>
          <p class="head-sub reveal">
            No jargon and no guesswork. Just clear, kind messages about what your body might be
            telling you.
          </p>
        </header>

        <ol class="how-steps">
          {
            how.map((h, i) => (
              <li class="how-step reveal" style={`--delay:${i * 90}ms`}>
                <span class="how-n numeral">{i + 1}</span>
                <div>
                  <h3 class="h4">{h.title}</h3>
                  <p class="muted how-body">{h.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="how-art" data-drift-area>
        <span class="how-blob hw-1" aria-hidden="true" data-drift="-26"></span>
        <span class="how-blob hw-2" aria-hidden="true" data-drift="30"></span>
        <div class="how-phone" data-drift="10">
          <PhoneDemo />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════ the sentence -->
  <section class="panel sentence-sec">
    <div class="page">
      <figure class="sentence">
        <blockquote class="display sentence-quote" data-split>
          “No, that’s <span class="mark-word">not normal.<svg
              class="mark draw"
              style="--draw-delay:0.9s"
              viewBox="0 0 300 24"
              aria-hidden="true"><path pathLength="1" d="M5 14c55-7 120-11 190-8 35 1 68 5 100 10"></path></svg
            ></span> Let’s sort it out.”
        </blockquote>
        <figcaption class="head-sub sentence-foot reveal" style="--delay:300ms">
          Marlo is on your side. It works alongside your doctor, never instead of them.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ═════════════════════════════════════════════ show your doctor -->
  <section class="section" id="report">
    <div class="page report">
      <div class="report-copy">
        <header class="head head-left">
          <h2 class="h1" data-split>Show your doctor, don’t just tell them.</h2>
          <p class="head-sub reveal">
            Marlo turns your check-ins into a clear, one-page summary, so nothing gets forgotten in a
            ten-minute appointment.
          </p>
        </header>
        <ul class="bullets report-list reveal" style="--delay:150ms">
          <li>How you’ve been feeling, and how often</li>
          <li>Your symptoms, and when they tend to show up</li>
          <li>How long your cycles really are</li>
          <li>You choose what to share, and who with</li>
        </ul>
      </div>
      <div class="report-art reveal" style="--delay:120ms">
        <HealthReport />
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════════════════════════ what's inside -->
  <section class="panel on-deep inside-sec" id="inside">
    <div class="page">
      <header class="head">
        <h2 class="h1" data-split>Everything you need, in one app.</h2>
      </header>
    </div>

    <div class="inside reveal">
      <Marquee speed={44} label="What’s in the app">
        {
          inside1.map((c) => (
            <li class="chip">
              <span class="chip-badge" aria-hidden="true">
                <Icon name={c.icon} />
              </span>
              {c.label}
            </li>
          ))
        }
      </Marquee>
      <Marquee speed={50} reverse label="More of what’s in the app">
        {
          inside2.map((c) => (
            <li class="chip">
              <span class="chip-badge" aria-hidden="true">
                <Icon name={c.icon} />
              </span>
              {c.label}
            </li>
          ))
        }
      </Marquee>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ you're safe here -->
  <section class="section" id="safe">
    <div class="page">
      <header class="head">
        <h2 class="h1" data-split>You’re safe here.</h2>
        <p class="head-sub reveal">Your health is personal. Here’s how we look after you.</p>
      </header>

      <div class="deck">
        {
          promise.map((c, i) => (
            <div class="deck-item reveal" style={`--delay:${i * 90}ms`}>
              <StoryCard {...c} />
            </div>
          ))
        }
      </div>

      <ul class="safety">
        {
          safety.map((s, i) => (
            <li class="safety-item reveal" style={`--delay:${i * 80}ms`}>
              <span class="safety-icon" aria-hidden="true">
                <Icon name={s.icon} />
              </span>
              <h3 class="h4">{s.title}</h3>
              <p class="small muted">{s.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════ download -->
  <section class="panel dl-sec on-berry" id="download" data-drift-area>
    <span class="dl-blob db-1" aria-hidden="true" data-drift="-40"></span>
    <span class="dl-blob db-2" aria-hidden="true" data-drift="34"></span>
    <span class="dl-blob db-3" aria-hidden="true" data-drift="-22"></span>

    <div class="page dl-inner">
      <h2 class="display dl-title" data-split>
        Start feeling <span class="swash-word">understood.<svg
            class="swash draw"
            style="--draw-delay:1s"
            viewBox="0 0 300 24"
            aria-hidden="true"
            ><path pathLength="1" d="M4 16c60-9 130-13 200-9 30 2 62 5 92 9"></path></svg
          ></span>
      </h2>
      <p class="head-sub dl-lead reveal" style="--delay:300ms">
        Download Marlo and set it up in a few minutes. Skip anything you’re not ready to answer.
      </p>

      <div class="stores reveal" style="--delay:450ms">
        {
          stores.map((s) => (
            <a
              class="store"
              href={s.href || DOWNLOAD_ANCHOR}
              data-magnetic
              rel={s.href ? 'noopener' : undefined}
            >
              <span class="store-icon" aria-hidden="true">
                {s.icon === 'apple' ? (
                  <svg viewBox="0 0 24 24">
                    <path d="M16.4 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9s-1.8-.9-3-.8C7 7.4 5.6 8.3 4.8 9.7c-1.7 2.9-.4 7.2 1.2 9.6.8 1.2 1.7 2.4 3 2.4 1.2-.1 1.6-.8 3.1-.8s1.8.8 3 .8c1.3 0 2.1-1.2 2.9-2.3.9-1.3 1.3-2.6 1.3-2.7 0 0-2.5-1-2.9-4.1ZM14.1 5.6c.6-.8 1.1-1.9 1-3-.9 0-2.1.6-2.7 1.4-.6.7-1.1 1.8-1 2.9 1 .1 2.1-.5 2.7-1.3Z" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24">
                    <path d="M4.2 2.6c-.3.3-.4.7-.4 1.2v16.4c0 .5.1.9.4 1.2l9.3-9.4Z" />
                    <path d="m16.6 15.1-3.1-3.1 3.1-3.1 3.6 2c1 .6 1 1.6 0 2.2Z" opacity=".75" />
                    <path d="m16.6 8.9-11-6.3c-.5-.3-1-.3-1.4 0l9.3 9.4Z" opacity=".55" />
                    <path d="m16.6 15.1-3.1-3.1-9.3 9.4c.4.3.9.3 1.4 0Z" opacity=".9" />
                  </svg>
                )}
              </span>
              <span class="store-text">
                <span class="store-pre">{s.pre}</span>
                <span class="store-name">{s.name}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>




  @keyframes blob-morph {
    0% {
      border-radius: 54% 46% 48% 52% / 50% 52% 48% 50%;
      rotate: 0deg;
    }
    50% {
      border-radius: 40% 60% 62% 38% / 58% 40% 60% 42%;
    }
    100% {
      border-radius: 60% 40% 44% 56% / 42% 60% 40% 58%;
      rotate: 40deg;
    }
  }

  /* ═════════════════════════════════════════════════════════════ story */
  .story .truths {
    max-width: 52rem;
    margin-inline: auto;
  }

  .truths {
    list-style: none;
    padding: 0;
    margin-top: clamp(2.5rem, 1.5rem + 2vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .truth {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: var(--s-lg);
    align-items: baseline;
    padding-block: clamp(1.25rem, 0.8rem + 1.2vw, 1.85rem);
    border-bottom: 1px solid var(--line);
    transition: opacity 0.6s ease;
  }

  .truth-num {
    font-size: 1.15rem;
    color: var(--accent);
    transition: transform 0.6s var(--ease-spring);
  }

  .truth-text {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(1.3rem, 1rem + 1.3vw, 2.1rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
    transition: translate 0.7s var(--ease-out);
  }

  /* Lines light up one at a time as you read down */
  :global(.js-motion) .is-spotlit .truth {
    opacity: 0.22;
  }

  :global(.js-motion) .is-spotlit .truth.is-lit {
    opacity: 1;
  }

  :global(.js-motion) .is-spotlit .truth:not(.is-lit) .truth-text {
    translate: 0.6rem 0;
  }

  :global(.js-motion) .is-spotlit .truth.is-lit .truth-num {
    transform: scale(1.15);
  }

  /* ════════════════════════════════════════════════════════════ turn */

  .turn {
    font-size: clamp(2.6rem, 1.2rem + 6vw, 7rem);
    max-width: 14ch;
  }

  .turn-b {
    color: var(--blush);
  }

  /* ════════════════════════════════════════════════════════════ jobs */
  .jobs {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    display: grid;
    gap: clamp(1rem, 0.5rem + 1.2vw, 1.5rem);
  }

  @media (min-width: 52rem) {
    .jobs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .jobs > div {
    display: flex;
  }

  .jobs > div > :global(*) {
    flex: 1;
  }

  /* ═════════════════════════════════════════════════════════════ how */

  .how {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .how {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    }
  }

  .how-steps {
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;
    display: grid;
    gap: 1.5rem;
    max-width: 32rem;
  }

  .how-step {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1rem;
    align-items: start;
  }

  .how-n {
    width: 2.75rem;
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--paper);
    color: var(--clay);
    font-size: 1.25rem;
  }

  .how-body {
    margin-top: 0.35rem;
  }

  .how-art {
    position: relative;
    padding-block: 2rem;
    isolation: isolate;
  }

  .how-blob {
    position: absolute;
    z-index: -1;
    aspect-ratio: 1;
    animation: blob-morph 16s ease-in-out infinite alternate;
  }

  .hw-1 {
    width: 70%;
    background: var(--blush);
    left: -4%;
    top: 4%;
  }

  .hw-2 {
    width: 46%;
    background: var(--butter);
    right: 0;
    bottom: 2%;
    animation-delay: -5s;
  }

  .how-phone {
    width: min(78%, 20rem);
    margin-inline: auto;
  }

  /* ════════════════════════════════════════════════════════ sentence */

  .sentence {
    margin: 0;
    max-width: 58rem;
  }

  .sentence-quote {
    margin-top: 1.75rem;
    font-size: clamp(2.3rem, 1.2rem + 4.6vw, 5.4rem);
  }

  .sentence-foot {
    margin-top: 2.25rem;
    color: var(--ink-muted);
  }

  /* ═══════════════════════════════════════════════════════════ report */
  .report {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .report {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    }
  }

  .report-list {
    margin-top: 2rem;
  }

  /* ═══════════════════════════════════════════════════════════ inside */
  .inside {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 3.5rem);
    display: grid;
    gap: 0.85rem;
    --mq-gap: 0.85rem;
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: var(--paper);
    border-radius: var(--r-pill);
    padding: 0.7rem 1.5rem 0.7rem 0.7rem;
    font-size: var(--t-body);
    font-weight: 600;
    white-space: nowrap;
    transition:
      transform 0.35s var(--ease-spring),
      background-color 0.25s ease;
  }

  .chip:hover {
    transform: translateY(-3px) rotate(-1.5deg);
    background: var(--sky);
  }

  .chip-badge {
    width: 2.6rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--cream-deep);
    color: var(--berry);
    display: grid;
    place-items: center;
    padding: 0.65rem;
    flex-shrink: 0;
  }

  /* ═════════════════════════════════════════════════════════════ safe */
  .deck {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    display: grid;
    gap: clamp(1rem, 0.5rem + 1.2vw, 1.5rem);
  }

  @media (min-width: 46rem) {
    .deck {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .deck {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .deck-item {
    display: flex;
  }

  .deck-item > :global(*) {
    flex: 1;
  }

  .safety {
    list-style: none;
    padding: 0;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    display: grid;
    gap: clamp(1.75rem, 1rem + 2vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .safety-item {
    display: grid;
