---
import DownloadButton from './DownloadButton.astro';
import Icon from './Icon.astro';

/**
 * The hero, as the whole idea in one movement.
 *
 * Centred headline, and the app rising from the bottom of the frame. Around
 * it float the scattered pieces of her health: the notes, the symptoms, the
 * things she's been told. It plays once on load: the pieces pop in, hang
 * there for a moment, fly into the phone one by one, and then the screen
 * turns them into one clear, calm answer.
 *
 * Without JS (or with reduced motion) everything is shown at rest: the
 * pieces around the phone, and the answer on its screen.
 */

type Frag = {
  text: string;
  kind: 'note' | 'chip';
  tone: 'paper' | 'butter' | 'blush' | 'sky';
  x: number; // % of frame width
  y: number; // % of frame height
  r: number; // rotation
  d: number; // pointer depth
  m?: [number, number]; // position on small screens (hidden there if absent)
};

const frags: Frag[] = [
  { text: '“Probably just stress.”', kind: 'note', tone: 'paper', x: 11, y: 30, r: -6, d: 26, m: [30, 63] },
  { text: 'Tired', kind: 'chip', tone: 'butter', x: 25, y: 52, r: 5, d: 38, m: [82, 65] },
  { text: 'Day 34??', kind: 'note', tone: 'blush', x: 86, y: 28, r: 7, d: 30, m: [76, 76] },
  { text: 'Cramps', kind: 'chip', tone: 'blush', x: 75, y: 50, r: -4, d: 42, m: [20, 75] },
  { text: 'GP, Tues 9:15', kind: 'note', tone: 'butter', x: 8, y: 66, r: 4, d: 22 },
  { text: 'Can’t sleep', kind: 'chip', tone: 'sky', x: 88, y: 66, r: 6, d: 34, m: [74, 88] },
  { text: 'Blood test results?', kind: 'note', tone: 'sky', x: 22, y: 84, r: -5, d: 30 },
  { text: 'Brain fog', kind: 'chip', tone: 'paper', x: 31, y: 70, r: -7, d: 46, m: [26, 89] },
  { text: 'Headaches', kind: 'chip', tone: 'butter', x: 70, y: 78, r: 5, d: 40 },
  { text: 'Specialist: 7 month wait', kind: 'note', tone: 'paper', x: 82, y: 88, r: -3, d: 24 },
  { text: 'Bloated', kind: 'chip', tone: 'sky', x: 12, y: 46, r: 3, d: 36 },
  { text: 'Moody', kind: 'chip', tone: 'blush', x: 91, y: 44, r: -6, d: 44 },
];

const found = [
  { name: 'Tired', n: 9 },
  { name: 'Cramps', n: 4 },
  { name: 'Headaches', n: 3 },
];
---

<section class="hs" id="top" aria-labelledby="hs-title">
  <div class="hs-frame" data-drift-area>
    <div class="hs-copy">
      <h1 id="hs-title" class="display hs-title" data-split style="--split-delay:150ms">
        Your body.<br /><span class="hs-line">Finally <span class="swash-word">understood.<svg
            class="swash draw"
            style="--draw-delay:1.1s"
            viewBox="0 0 300 24"
            preserveAspectRatio="none"
            aria-hidden="true"
            ><path pathLength="1" d="M4 16c60-9 130-13 200-9 30 2 62 5 92 9"></path></svg
          ></span></span>
      </h1>
      <div class="hs-cta reveal" style="--delay:600ms">
        <DownloadButton size="lg" tone="cream" />
      </div>
    </div>

    <!-- the scattered pieces of her health -->
    <div class="hs-frags" aria-hidden="true">
      {
        frags.map((f, i) => (
          <span
            class:list={['frag', `frag-${f.kind}`, `frag-${f.tone}`, !f.m && 'frag-wide']}
            style={`--x:${f.x}%;--y:${f.y}%;${f.m ? `--mx:${f.m[0]}%;--my:${f.m[1]}%;` : ''}--r:${f.r}deg;--i:${i}`}
          >
            <span class="frag-drift" data-drift={f.d}>
              <span class="frag-bob">
                {f.kind === 'chip' && <span class="frag-dot" />}
                {f.text}
              </span>
            </span>
          </span>
        ))
      }
    </div>

    <!-- the app, rising from the bottom of the frame -->
    <div class="hs-phone-wrap">
      <div class="hs-phone" role="img" aria-label="The Marlo app turning your notes and symptoms into one clear summary: you've felt tired nine times this month, mostly in the week before your period, which is worth mentioning to your GP.">
        <div class="hs-screen" aria-hidden="true">
          <div class="hs-status">
            <span>9:41</span>
            <span class="hs-island"></span>
            <span class="hs-bars"><i></i><i></i><i></i></span>
          </div>

          <div class="hs-app">
            <p class="hs-hello">Good morning</p>
            <p class="hs-h">Here’s what we’ve noticed</p>

            <div class="hs-card hs-found" data-stage="0">
              <p class="hs-k">This month</p>
              <ul class="hs-chips">
                {
                  found.map((f) => (
                    <li>
                      {f.name} <b class="numeral">{f.n}×</b>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div class="hs-card hs-insight" data-stage="1">
              <span class="hs-from"><span class="hs-dot"></span>Marlo</span>
              Most of this happens in the week before your period. That’s worth mentioning to your GP.
            </div>

            <div class="hs-card hs-ready" data-stage="2">
              <span class="hs-ready-ic"><Icon name="note" /></span>
              <span>
                <b>Your summary is ready</b>
                <span>Show it at your next appointment</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('.hs');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && !reduced && !section.dataset.played) {
    section.dataset.played = 'true';
    section.classList.add('is-live');
    const frame = section.querySelector<HTMLElement>('.hs-frame')!;
    const screen = section.querySelector<HTMLElement>('.hs-screen')!;
    const phone = section.querySelector<HTMLElement>('.hs-phone')!;
    const frags = Array.from(section.querySelectorAll<HTMLElement>('.frag'));
    const stages = Array.from(section.querySelectorAll<HTMLElement>('[data-stage]'));

    const clamp = (n: number) => Math.min(1, Math.max(0, n));
    const easeIn = (t: number) => t * t;

    // Where each piece has to travel to reach the middle of the screen
    let deltas: { dx: number; dy: number }[] = [];
    function measure() {
      const s = screen.getBoundingClientRect();
      const tx = s.left + s.width / 2;
      const ty = s.top + Math.min(s.height, frame.getBoundingClientRect().bottom - s.top) * 0.4;
      deltas = frags.map((f) => {
        // measure from the resting position, ignoring the current fly transform
        const prev = f.style.transform;
        f.style.transform = 'none';
        const b = f.getBoundingClientRect();
        f.style.transform = prev;
        return { dx: tx - (b.left + b.width / 2), dy: ty - (b.top + b.height / 2) };
      });
    }

    /* The timeline, in ms from the start */
    const POP_END = 2300; // pieces have popped in (CSS, see .frag-drift)
    const FLY_START = 2800; // after a short hold
    const FLY_GAP = 180; // between each piece leaving
    const FLY_DUR = 750; // each piece's flight
    const n = frags.length;
    const FLY_END = FLY_START + (n - 1) * FLY_GAP + FLY_DUR;
    const STAGES = [FLY_END - 200, FLY_END + 500, FLY_END + 1200];

    let t0 = 0;
    let shown = -1;
    let done = false;

    function update(now: number) {
      const t = now - t0;
      let landed = 0;

      if (t >= FLY_START) {
        frags.forEach((f, i) => {
          const k = clamp((t - FLY_START - i * FLY_GAP) / FLY_DUR);
          const e = easeIn(k);
          const d = deltas[i];
          if (!d) return;
          if (k >= 1) landed++;
          f.style.transform = `translate(${(d.dx * e).toFixed(1)}px, ${(d.dy * e).toFixed(1)}px) rotate(${(
            -12 * e
          ).toFixed(2)}deg) scale(${(1 - 0.8 * e).toFixed(3)})`;
          f.style.opacity = String(1 - clamp((k - 0.7) / 0.3));
        });
        // The phone takes in each piece with a tiny pulse
        phone.style.scale = String(1 + Math.sin(clamp(landed / n) * Math.PI) * 0.025);
      }

      // Then the screen fills in, card by card
      const stage = STAGES.filter((at) => t >= at).length - 1;
      if (stage !== shown) {
        shown = stage;
        stages.forEach((el, k) => el.classList.toggle('is-on', k <= stage));
      }

      if (t > STAGES[STAGES.length - 1] + 1000) {
        phone.style.scale = '';
        done = true;
      }
    }

    function start() {
      measure();
      window.addEventListener('resize', measure);
      t0 = performance.now();
      const loop = (now: number) => {
        // Re-measure once the pieces have settled from their pop-in
        if (now - t0 >= POP_END && now - t0 < POP_END + 20) measure();
        update(now);
        if (!done) requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }

    // Wait for the fonts, so the pieces are measured at their real size
    const ready = document.fonts?.ready ?? Promise.resolve();
    ready.then(start, start);
  }
</script>

<style>
  .hs {
    position: relative;
    color: var(--cream);
  }

  .hs-frame {
    position: relative;
    margin-top: var(--inset);
    margin-inline: var(--inset);
    border-radius: var(--r-panel);
    background: var(--clay);
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(6.5rem, 4rem + 6vh, 8.5rem) var(--gutter) 0;
    text-align: center;
  }

  .hs-copy {
    position: relative;
    z-index: 3;
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* "Finally understood." always stays on one line, so the size follows
     the screen width on phones */
  .hs-title {
    font-size: clamp(1.9rem, 0.4rem + 8.6vw, 6.6rem);
  }

  .hs-line {
    white-space: nowrap;
  }

  .hs-cta {
    margin-top: 2.25rem;
  }

  .hs :global(:focus-visible) {
    outline-color: var(--butter);
  }

  /* ─────────────────────────────────────────────────────────── pieces */
  .hs-frags {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .frag {
    position: absolute;
    left: var(--x);
    top: var(--y);
    translate: -50% -50%;
    will-change: transform, opacity;
  }

  .frag-drift {
    display: block;
  }

  .frag-bob {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    rotate: var(--r);
    animation: frag-bob 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.7s);
    box-shadow: 0 14px 28px -16px rgba(90, 9, 38, 0.55);
    color: var(--berry);
  }

  .frag-note .frag-bob {
    padding: 0.85rem 1rem 1.05rem;
    border-radius: 6px 6px 16px 6px;
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 0.8rem + 0.45vw, 1.25rem);
    line-height: 1.1;
  }

  .frag-chip .frag-bob {
    padding: 0.55rem 1rem 0.55rem 0.8rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: clamp(0.85rem, 0.78rem + 0.25vw, 1rem);
  }

  .frag-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--clay);
  }

  .frag-paper .frag-bob {
    background: var(--paper);
  }
  .frag-butter .frag-bob {
    background: var(--butter);
  }
  .frag-blush .frag-bob {
    background: var(--blush);
  }
  .frag-sky .frag-bob {
    background: var(--sky);
  }

  @keyframes frag-bob {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -10px;
    }
  }

  /* On small screens, fewer pieces, kept to the sides */
  @media (max-width: 47.99rem) {
    .frag-wide {
      display: none;
    }
    .frag {
      left: var(--mx);
      top: var(--my);
    }
    .frag-note .frag-bob {
      font-size: 0.85rem;
      padding: 0.6rem 0.75rem 0.75rem;
    }
    .frag-chip .frag-bob {
      font-size: 0.8rem;
      padding: 0.45rem 0.8rem 0.45rem 0.65rem;
    }
  }

  /* Entrance: pieces pop in after the headline */
  :global(.js-motion) .frag-drift {
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 0.6s ease,
      scale 0.9s var(--ease-spring);
    transition-delay: calc(0.9s + var(--i) * 80ms);
  }

  :global(.js-motion) .hs.is-live .frag-drift {
    opacity: 1;
    scale: 1;
  }

  /* ─────────────────────────────────────────────────────────── phone */
  /* The phone rises from the bottom edge, its lower part cropped by the
     frame. The frame grows to fit it. */
  .hs-phone-wrap {
    position: relative;
    z-index: 1;
    margin-top: clamp(2rem, 1rem + 3vh, 3.5rem);
    width: clamp(15.5rem, 10rem + 14vw, 20rem);
    aspect-ratio: 9 / 11.4;
    overflow: hidden;
    flex: none;
  }

  /* Desktop: a bigger phone */
  @media (min-width: 62rem) {
    .hs-phone-wrap {
      width: clamp(22rem, 12rem + 12vw, 27rem);
      aspect-ratio: 9 / 11.5;
      margin-top: clamp(2.5rem, 1rem + 3vh, 3.5rem);
    }
  }

  .hs-phone {
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 9 / 19;
    border-radius: 3rem;
    background: var(--berry);
    padding: 0.6rem;
    transform-origin: 50% 0;
  }

  .hs-screen {
    height: 100%;
    border-radius: 2.5rem;
    background: var(--cream);
    color: var(--berry);
    overflow: hidden;
    font-size: 4.4cqw;
    text-align: left;
  }

  .hs-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4.5cqw 8cqw 0;
    height: 13cqw;
    font-size: 0.8em;
    font-weight: 700;
  }

  .hs-island {
    width: 26cqw;
    height: 7.5cqw;
    border-radius: 99px;
    background: var(--berry);
  }

  .hs-bars {
    display: flex;
    gap: 0.8cqw;
    align-items: flex-end;
  }

  .hs-bars i {
    width: 1.3cqw;
    background: var(--berry);
    border-radius: 1px;
  }
  .hs-bars i:nth-child(1) { height: 1.6cqw; }
  .hs-bars i:nth-child(2) { height: 2.4cqw; }
  .hs-bars i:nth-child(3) { height: 3.2cqw; }

  .hs-app {
    padding: 4cqw 6cqw;
    display: grid;
    gap: 3.2cqw;
  }

  .hs-hello {
    font-size: 0.72em;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--clay);
  }

  .hs-h {
    font-family: var(--font-display);
    font-size: 1.7em;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin-top: -2.5cqw;
  }

  .hs-card {
    border-radius: 6cqw;
    padding: 4.4cqw;
  }

  .hs-found {
    background: var(--paper);
  }

  .hs-k {
    font-size: 0.7em;
    font-weight: 700;
    color: var(--ink-muted);
    margin-bottom: 2.4cqw;
  }

  .hs-chips {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.8cqw;
  }

  .hs-chips li {
    display: inline-flex;
    align-items: center;
    gap: 1.4cqw;
    padding: 1.6cqw 3cqw;
    border-radius: 99px;
    background: var(--butter);
    font-weight: 700;
    font-size: 0.78em;
  }

  .hs-chips li:nth-child(2) {
    background: var(--blush);
  }
  .hs-chips li:nth-child(3) {
    background: var(--sky);
  }

  .hs-chips b {
    color: var(--clay);
    font-weight: 400;
  }

  .hs-insight {
    background: var(--blush);
    border-radius: 6cqw 6cqw 6cqw 1.5cqw;
    font-size: 0.88em;
    line-height: 1.42;
  }

  .hs-from {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    font-size: 0.72em;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1.6cqw;
    opacity: 0.75;
  }

  .hs-dot {
    width: 2cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--clay);
  }

  .hs-ready {
    background: var(--sky);
    display: flex;
    gap: 3.4cqw;
    align-items: center;
  }

  .hs-ready-ic {
    width: 10cqw;
    flex-shrink: 0;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper);
    padding: 2.4cqw;
    display: grid;
  }

  .hs-ready b {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.08em;
    line-height: 1.1;
  }

  .hs-ready span span {
    display: block;
    font-size: 0.72em;
    opacity: 0.8;
    margin-top: 0.6cqw;
  }

  /* Screen cards wait for the pieces to arrive */
  .hs.is-live [data-stage] {
    opacity: 0;
    translate: 0 6cqw;
    scale: 0.94;
    transform-origin: 50% 100%;
    transition:
      opacity 0.5s ease,
      translate 0.8s var(--ease-out),
      scale 0.8s var(--ease-spring);
  }

  .hs.is-live [data-stage].is-on {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .frag-bob {
      animation: none;
    }
  }
</style>
