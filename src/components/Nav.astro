---
import Wordmark from './Wordmark.astro';
import DownloadButton from './DownloadButton.astro';
import { withBase } from '../site';

/* One page, so the nav is a short table of contents. Floats as a pill. */
const links = [
  { href: withBase('/#story'), label: 'For you' },
  { href: withBase('/#how'), label: 'How it helps' },
  { href: withBase('/#safe'), label: 'Your safety' },
];
---

<a class="skip" href="#main">Skip to content</a>

<header class="nav">
  <div class="nav-pill">
    <a href={withBase('/')} class="nav-brand" aria-label="Marlo home">
      <Wordmark size={30} dot="clay" />
    </a>

    <nav class="nav-links" aria-label="Sections">
      {
        links.map((l) => (
          <a href={l.href} class="nav-link">
            {l.label}
          </a>
        ))
      }
    </nav>

    <DownloadButton size="sm" class="nav-cta" />
    <span class="nav-progress" data-progress aria-hidden="true"></span>
  </div>
</header>

<script>
  // The pill firms up once you've scrolled
  const header = document.querySelector('.nav');
  const onScroll = () => header?.classList.toggle('is-stuck', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Underline the section you're reading
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link'));
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((l) => l.classList.toggle('is-current', l.hash === `#${e.target.id}`));
      });
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  links.forEach((l) => {
    const t = document.querySelector(l.hash);
    if (t) io.observe(t);
  });
</script>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--berry);
    color: var(--cream);
    padding: 0.85rem 1.25rem;
    border-radius: 0 0 var(--r-sm) 0;
    font-weight: 700;
    text-decoration: none;
  }

  .skip:focus {
    left: 0;
  }

  .nav {
    position: fixed;
    top: max(1.1rem, env(safe-area-inset-top));
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 1rem;
    pointer-events: none;
  }

  .nav-pill {
    pointer-events: auto;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 0.2rem + 2vw, 2.5rem);
    width: 100%;
    max-width: 44rem;
    justify-content: space-between;
    padding: 0.35rem 0.35rem 0.35rem 1.15rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 78%, transparent);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    box-shadow:
      0 0 0 1px rgba(117, 13, 50, 0.06),
      0 10px 30px -14px rgba(90, 9, 38, 0.3);
    transition:
      background-color 0.4s ease,
      box-shadow 0.4s ease;
    animation: nav-drop 0.9s var(--ease-spring) 0.2s both;
  }

  .nav.is-stuck .nav-pill {
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    box-shadow:
      0 0 0 1px rgba(117, 13, 50, 0.08),
      0 14px 34px -14px rgba(90, 9, 38, 0.38);
  }

  @keyframes nav-drop {
    from {
      translate: 0 -140%;
      opacity: 0;
    }
  }

  .nav-brand {
    text-decoration: none;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    transition: transform 0.4s var(--ease-spring);
  }

  .nav-brand :global(.wm) {
    padding: 0.2em 0;
  }

  .nav-brand:hover {
    transform: rotate(-3deg) scale(1.04);
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: clamp(1rem, 0.4rem + 1.6vw, 2rem);
  }

  @media (min-width: 52rem) {
    .nav-links {
      display: flex;
    }
  }

  .nav-link {
    position: relative;
    text-decoration: none;
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--ink-muted);
    padding-block: 0.4rem;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.is-current {
    color: var(--berry);
  }

  /* A clay dot that grows into an underline */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 999px;
    background: var(--clay);
    translate: -50% 0;
    scale: 0;
    transition:
      scale 0.35s var(--ease-spring),
      width 0.45s var(--ease-out),
      height 0.3s ease;
  }

  .nav-link:hover::after {
    scale: 1;
  }

  .nav-link.is-current::after {
    scale: 1;
    width: 100%;
    height: 2px;
  }

  .nav-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--clay);
    transform-origin: 0 50%;
    transform: scaleX(0);
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-pill {
      animation: none;
    }
  }
</style>
