---
/**
 * The site's single call to action. Always says the same thing.
 *
 * Links to the store badges at #download; on iOS/Android, motion.ts swaps the
 * href for the matching store listing (see src/site.ts).
 */
import { DOWNLOAD_ANCHOR } from '../site';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  /** Colourway: berry on light surfaces, cream on clay/berry. */
  tone?: 'berry' | 'cream';
  class?: string;
}

const { size = 'md', tone = 'berry', class: className = '' } = Astro.props;
---

<a
  href={DOWNLOAD_ANCHOR}
  class:list={['btn', 'dl', `dl-${size}`, `dl-${tone}`, className]}
  data-download
  data-magnetic
>
  <span class="dl-label">Download the app</span>
  <span class="dl-arrow" aria-hidden="true">
    <svg viewBox="0 0 24 24"><path d="M12 5v13M6.5 12.5 12 18l5.5-5.5"></path></svg>
  </span>
</a>

<style>
  .dl {
    white-space: nowrap;
    gap: 0.75rem;
    padding-right: 0.55rem;
    isolation: isolate;
    overflow: hidden;
    position: relative;
  }

  .dl-md {
    padding-block: 0.55rem;
    padding-left: 1.6rem;
  }

  .dl-lg {
    font-size: 1.0625rem;
    padding-block: 0.65rem;
    padding-left: 1.9rem;
    padding-right: 0.65rem;
  }

  .dl-sm {
    font-size: 0.9375rem;
    padding-block: 0.4rem;
    padding-left: 1.15rem;
    padding-right: 0.4rem;
    gap: 0.55rem;
  }

  .dl-arrow {
    width: 2.6rem;
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--clay);
    color: var(--cream);
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .dl-sm .dl-arrow {
    width: 2rem;
  }

  .dl-lg .dl-arrow {
    width: 3rem;
  }

  .dl-arrow svg {
    width: 55%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dl:hover .dl-arrow {
    transform: rotate(-12deg) scale(1.08);
  }

  .dl:hover .dl-arrow svg {
    animation: dl-bounce 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  }

  .dl-cream {
    background: var(--cream);
    color: var(--berry);
  }

  .dl-cream:hover {
    background: var(--paper);
  }

  @keyframes dl-bounce {
    0%,
    100% {
      transform: translateY(-1px);
    }
    50% {
      transform: translateY(2.5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dl:hover .dl-arrow,
    .dl:hover .dl-arrow svg {
      transform: none;
      animation: none;
    }
  }
</style>
