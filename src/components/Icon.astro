---
import { ICON_PATHS, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  set:html={ICON_PATHS[name]}
></svg>

<style>
  .icon {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
