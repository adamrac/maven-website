---
import Icon from './Icon.astro';

/**
 * A moment in the app, played out when it scrolls into view: a check-in, the
 * cycle estimate, Marlo "typing", an insight, then a nudge about the report.
 *
 * Built from container-query units so the whole phone scales as one object.
 * With no JS or reduced motion it renders as a still, complete screen.
 */
const moods = ['Low', 'Meh', 'Okay', 'Good', 'Great'];
const tabs = [
  { icon: 'heart', label: 'Today' },
  { icon: 'calendar', label: 'Track' },
  { icon: 'chart', label: 'Insights' },
  { icon: 'note', label: 'Report' },
] as const;
const cycleDay = 22;
const cycleLen = 29;
const r = 34;
const circ = 2 * Math.PI * r;
---

<div class="phone" data-inview role="img" aria-label="The Marlo app: a morning check-in, when your next period is due, and a gentle note about feeling tired">
  <div class="phone-screen" aria-hidden="true">
    <div class="phone-status">
      <span>9:41</span>
      <span class="phone-island"></span>
      <span class="phone-bars"><i></i><i></i><i></i></span>
    </div>

    <div class="track">
      <p class="p-hello step" style="--t:0.15s">Good morning</p>
      <p class="p-title step" style="--t:0.3s">How are you feeling today?</p>

      <div class="moods step" style="--t:0.55s">
        {
          moods.map((m, i) => (
            <span class:list={['mood', i === 3 && 'is-pick']}>
              <span class="mood-dot">
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="9" />
                  <path d={['M8 16c2.4-2 5.6-2 8 0', 'M8.5 15.5h7', 'M8.5 15h7', 'M8 14.5c2.4 2 5.6 2 8 0', 'M7.5 13.5c2.6 3.4 6.4 3.4 9 0'][i]} />
                  <path d="M9 9.6h.01M15 9.6h.01" />
                </svg>
              </span>
              <span class="mood-label">{m}</span>
            </span>
          ))
        }
      </div>

      <div class="cyc step" style="--t:1.5s">
        <svg class="cyc-ring" viewBox="0 0 80 80">
          <circle cx="40" cy="40" r={r} class="cyc-track" />
          <circle
            cx="40"
            cy="40"
            r={r}
            class="cyc-fill"
            style={`--circ:${circ.toFixed(1)};--to:${(circ * (1 - cycleDay / cycleLen)).toFixed(1)}`}
          />
          <text x="40" y="38" class="cyc-day">{cycleDay}</text>
          <text x="40" y="52" class="cyc-of">of ~{cycleLen}</text>
        </svg>
        <div>
          <p class="cyc-k">Your cycle</p>
          <p class="cyc-t">Period in about 7 days</p>
          <p class="cyc-s">Based on your past cycles</p>
        </div>
      </div>

      <div class="chat">
        <span class="typing" style="--t:2.6s"><i></i><i></i><i></i></span>
        <div class="bubble step" style="--t:3.9s">
          <span class="bubble-from"><span class="bubble-dot"></span>Marlo</span>
          You’ve felt tired three days in a row. That often happens for you around this time of the month.
        </div>
      </div>

      <div class="nudge step" style="--t:5s">
        <span class="nudge-icon"><Icon name="note" /></span>
        <div>
          <p class="nudge-t">Appointment Thursday</p>
          <p class="nudge-s">Your summary is ready to show your GP.</p>
        </div>
      </div>
    </div>

    <nav class="tabs">
      {
        tabs.map((t, i) => (
          <span class:list={['tab', i === 0 && 'is-on']}>
            <Icon name={t.icon} />
            <span>{t.label}</span>
          </span>
        ))
      }
    </nav>
  </div>
</div>

<style>
  .phone {
    container-type: inline-size;
    width: min(100%, 20rem);
    aspect-ratio: 9 / 19;
    margin-inline: auto;
    border-radius: 3.2rem;
    background: var(--berry);
    padding: 0.7rem;
    box-shadow:
      0 40px 80px -30px rgba(90, 9, 38, 0.45),
      0 18px 30px -18px rgba(90, 9, 38, 0.3);
    position: relative;
  }

  .phone-screen {
    height: 100%;
    border-radius: 2.6rem;
    background: var(--cream);
    overflow: hidden;
    position: relative;
    font-size: 4.6cqw;
    color: var(--berry);
  }

  .phone-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4.5cqw 8cqw 0;
    font-size: 0.78em;
    font-weight: 700;
    position: relative;
    z-index: 2;
    background: var(--cream);
    height: 13cqw;
  }

  .phone-island {
    width: 26cqw;
    height: 7.5cqw;
    border-radius: 99px;
    background: var(--berry);
  }

  .phone-bars {
    display: flex;
    gap: 0.8cqw;
    align-items: flex-end;
  }

  .phone-bars i {
    width: 1.3cqw;
    background: var(--berry);
    border-radius: 1px;
  }
  .phone-bars i:nth-child(1) { height: 1.6cqw; }
  .phone-bars i:nth-child(2) { height: 2.4cqw; }
  .phone-bars i:nth-child(3) { height: 3.2cqw; }

  .track {
    padding: 4cqw 6cqw 8cqw;
    display: grid;
    gap: 4.5cqw;
  }

  .p-hello {
    font-size: 0.72em;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--clay);
  }

  .p-title {
    font-family: var(--font-display);
    font-size: 1.75em;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin-top: -2.5cqw;
  }

  /* Mood row */
  .moods {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5cqw;
  }

  .mood {
    display: grid;
    justify-items: center;
    gap: 1.2cqw;
  }

  .mood-dot {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper);
    display: grid;
    place-items: center;
    padding: 2.4cqw;
    transition:
      background-color 0.4s ease,
      transform 0.6s var(--ease-spring);
  }

  .mood-dot svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .mood-label {
    font-size: 0.6em;
    font-weight: 700;
    opacity: 0.6;
  }

  .is-pick .mood-dot {
    background: var(--sky);
  }

  /* Cycle card */
  .cyc {
    background: var(--butter);
    border-radius: 7cqw;
    padding: 4.5cqw;
    display: flex;
    gap: 4cqw;
    align-items: center;
  }

  .cyc-ring {
    width: 26cqw;
    flex-shrink: 0;
    rotate: -90deg;
  }

  .cyc-track,
  .cyc-fill {
    fill: none;
    stroke-width: 9;
  }

  .cyc-track {
    stroke: rgba(117, 13, 50, 0.1);
  }

  .cyc-fill {
    stroke: var(--clay);
    stroke-linecap: round;
    stroke-dasharray: var(--circ);
    stroke-dashoffset: var(--to);
  }

  .cyc-day,
  .cyc-of {
    rotate: 90deg;
    transform-origin: 40px 40px;
    text-anchor: middle;
    fill: var(--berry);
  }

  .cyc-day {
    font-family: var(--font-display);
    font-size: 22px;
  }

  .cyc-of {
    font-size: 9px;
    font-weight: 700;
    opacity: 0.6;
  }

  .cyc-k {
    font-size: 0.62em;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .cyc-t {
    font-family: var(--font-display);
    font-size: 1.3em;
    line-height: 1.1;
  }

  .cyc-s {
    font-size: 0.68em;
    opacity: 0.7;
    margin-top: 0.6cqw;
  }

  /* Chat */
  .chat {
    position: relative;
    min-height: 12cqw;
  }

  .typing {
    position: absolute;
    left: 0;
    top: 0;
    display: none;
    gap: 1.2cqw;
    padding: 3.6cqw 4.4cqw;
    border-radius: 6cqw 6cqw 6cqw 1.5cqw;
    background: var(--blush);
  }

  .typing i {
    width: 1.8cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--berry);
    animation: typing-dot 1s ease-in-out infinite;
  }
  .typing i:nth-child(2) { animation-delay: 0.15s; }
  .typing i:nth-child(3) { animation-delay: 0.3s; }

  .bubble {
    background: var(--blush);
    border-radius: 6cqw 6cqw 6cqw 1.5cqw;
    padding: 4cqw 4.6cqw;
    font-size: 0.86em;
    line-height: 1.42;
  }

  .bubble-from {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    font-size: 0.72em;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1.6cqw;
    opacity: 0.75;
  }

  .bubble-dot {
    width: 2cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--clay);
  }

  /* Report nudge */
  .nudge {
    background: var(--sky);
    border-radius: 7cqw;
    padding: 4.5cqw;
    display: flex;
    gap: 3.5cqw;
    align-items: flex-start;
  }

  .nudge-icon {
    width: 11cqw;
    flex-shrink: 0;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper);
    padding: 2.6cqw;
    display: grid;
  }

  .nudge-t {
    font-family: var(--font-display);
    font-size: 1.08em;
    line-height: 1.1;
  }

  .nudge-s {
    font-size: 0.72em;
    line-height: 1.4;
    margin-top: 1cqw;
    opacity: 0.8;
  }

  /* Tab bar */
  .tabs {
    position: absolute;
    left: 4cqw;
    right: 4cqw;
    bottom: 4cqw;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 2.6cqw 2cqw;
    border-radius: 99px;
    background: var(--paper);
    box-shadow: 0 6px 18px -8px rgba(90, 9, 38, 0.25);
  }

  .tab {
    display: grid;
    justify-items: center;
    gap: 0.6cqw;
    font-size: 0.56em;
    font-weight: 700;
    opacity: 0.5;
  }

  .tab :global(svg) {
    width: 6cqw;
    height: 6cqw;
  }

  .tab.is-on {
    opacity: 1;
    color: var(--clay);
  }

  @keyframes typing-dot {
    0%,
    100% {
      translate: 0 0;
      opacity: 0.4;
    }
    40% {
      translate: 0 -1.2cqw;
      opacity: 1;
    }
  }

  /* ─────────────────────────────── the sequence (motion-enabled only) ── */

  :global(.js-motion) .step {
    opacity: 0;
    translate: 0 5cqw;
    scale: 0.96;
    transform-origin: 0 100%;
  }

  :global(.js-motion) .phone.is-in .step {
    opacity: 1;
    translate: 0 0;
    scale: 1;
    transition:
      opacity 0.6s ease,
      translate 0.8s var(--ease-out),
      scale 0.8s var(--ease-spring);
    transition-delay: var(--t, 0s);
  }

  /* The fourth mood gets tapped */
  :global(.js-motion) .is-pick .mood-dot {
    background: var(--paper);
  }

  :global(.js-motion) .phone.is-in .is-pick .mood-dot {
    background: var(--sky);
    animation: mood-tap 0.6s var(--ease-spring) 1.1s both;
    transition-delay: 1.15s;
  }

  @keyframes mood-tap {
    40% {
      transform: scale(0.82);
    }
    100% {
      transform: scale(1.06);
    }
  }

  /* The ring fills to today */
  :global(.js-motion) .cyc-fill {
    stroke-dashoffset: var(--circ);
  }

  :global(.js-motion) .phone.is-in .cyc-fill {
    stroke-dashoffset: var(--to);
    transition: stroke-dashoffset 1.8s var(--ease-out) 1.8s;
  }

  /* Marlo types, then speaks */
  :global(.js-motion) .typing {
    display: flex;
    opacity: 0;
  }

  :global(.js-motion) .phone.is-in .typing {
    animation: typing-life 1.3s ease var(--t) both;
  }

  @keyframes typing-life {
    0% {
      opacity: 0;
      scale: 0.6;
    }
    20%,
    80% {
      opacity: 1;
      scale: 1;
    }
    100% {
      opacity: 0;
      scale: 0.9;
    }
  }

</style>
